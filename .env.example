# Required in production
JWT_SECRET=            # openssl rand -hex 32
ADMIN_EMAIL=admin@yourcollege.edu   # used once, to create the first admin
ADMIN_PASSWORD=        # 8+ chars; change it after first login (Account tab)
# Recommended
TRUST_PROXY=1          # number of reverse proxies in front (needed for correct client IPs / rate limiting)
BACKUP_KEEP=14         # daily DB backups kept in /data/backups
# Optional tuning
# LOGIN_RATE_MAX=10 API_RATE_MAX=300 GATE_REQUIRE_PASS=1 COOKIE_SECURE=1
